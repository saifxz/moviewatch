[Unit]
Description=Virtual X display and loopback VNC for movie-watch
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/rm -f /tmp/.X99-lock /tmp/.X11-unix/X99
ExecStart=__XVNC_BIN__ :99 -geometry 1365x900 -depth 24 -nolisten tcp -localhost -rfbport 5999 -SecurityTypes None
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
