[Unit]
Description=Movie watch watcher (District + BookMyShow CDN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
Environment=MOVIE_WATCH_DIR=__REPO_DIR__
Environment=MOVIE_WATCH_CONFIG=__REPO_DIR__/deploy/aws/config.aws.yaml
ExecStart=__REPO_DIR__/.venv/bin/movie-watch run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
